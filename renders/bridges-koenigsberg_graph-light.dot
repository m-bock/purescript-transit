digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 14.0
    bgcolor = "#ffffff"
    color = "#000000"
    fontcolor = "#000000"
    layout = dot
    rankdir = TD
  ]
  node [
    style = filled
    fontsize = 14.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 14.0
  ]
  
  // Nodes
  A [shape = box, label = <<b>A</b>>, height = 0.4, fontcolor = "#6ca114", fillcolor = "#a3e635", color = "#a3e635"]
  B [shape = box, label = <<b>B</b>>, height = 0.4, fontcolor = "#b38b00", fillcolor = "#ffc700", color = "#ffc700"]
  C [shape = box, label = <<b>C</b>>, height = 0.4, fontcolor = "#0c4590", fillcolor = "#2f80ed", color = "#2f80ed"]
  D [shape = box, label = <<b>D</b>>, height = 0.4, fontcolor = "#b8002c", fillcolor = "#ff527c", color = "#ff527c"]
  
  // Edges
  B -> A [label = <<b>a</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  B -> A [label = <<b>b</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  C -> A [label = <<b>c</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  C -> A [label = <<b>d</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  D -> A [label = <<b>e</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  D -> B [label = <<b>f</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
  D -> C [label = <<b>g</b>>, dir = both, color = "#000000", fontcolor = "#000000"]
}