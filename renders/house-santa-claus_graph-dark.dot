digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 14.0
    bgcolor = "#00000000"
    color = "#c8c8c8"
    fontcolor = "#c8c8c8"
    layout = neato
  ]
  node [
    style = filled
    fontsize = 14.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 14.0
  ]
  
  // Nodes
  1 [shape = box, label = <<b>1</b>>, pos = "0.0,0.0!", width = 0.6, height = 0.6, fixedsize = true, fontcolor = "#4d740e", fillcolor = "#a3e635", color = "#a3e635"]
  2 [shape = box, label = <<b>2</b>>, pos = "1.2,0.0!", width = 0.6, height = 0.6, fixedsize = true, fontcolor = "#806300", fillcolor = "#ffc700", color = "#ffc700"]
  3 [shape = box, label = <<b>3</b>>, pos = "1.2,1.2!", width = 0.6, height = 0.6, fixedsize = true, fontcolor = "#082e61", fillcolor = "#2f80ed", color = "#2f80ed"]
  5 [shape = box, label = <<b>5</b>>, pos = "0.6,2.4!", width = 0.6, height = 0.6, fixedsize = true, fontcolor = "#850020", fillcolor = "#ff527c", color = "#ff527c"]
  4 [shape = box, label = <<b>4</b>>, pos = "0.0,1.2!", width = 0.6, height = 0.6, fixedsize = true, fontcolor = "#104729", fillcolor = "#2dc472", color = "#2dc472"]
  
  // Edges
  2 -> 1 [label = <<b>a</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  3 -> 2 [label = <<b>b</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  3 -> 1 [label = <<b>f</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  5 -> 3 [label = <<b>c</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  5 -> 4 [label = <<b>d</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  4 -> 1 [label = <<b>e</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  4 -> 2 [label = <<b>g</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
  4 -> 3 [label = <<b>h</b>>, dir = both, color = "#6e6e6e", fontcolor = "#a0a0a0"]
}