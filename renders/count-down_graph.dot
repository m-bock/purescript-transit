digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#00000000"
    color = "#c8c8c8"
    fontcolor = "#c8c8c8"
    layout = dot
    rankdir = TD
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  Idle [shape = box, label = <<b>Idle</b>>, height = 0.4, fontcolor = "#4d740e", fillcolor = "#a3e635", color = "#a3e635"]
  Counting [shape = box, label = <<b>Counting</b>>, height = 0.4, fontcolor = "#806300", fillcolor = "#ffc700", color = "#ffc700"]
  __DECISION__Counting__Tick [shape = diamond, label = "?", fontcolor = "#806300", fillcolor = "#ffc700"]
  Done [shape = box, label = <<b>Done</b>>, height = 0.4, fontcolor = "#082e61", fillcolor = "#2f80ed", color = "#2f80ed"]
  
  // Edges
  Idle -> Counting [label = <<b>Start</b>>, color = "#a3e635", fontcolor = "#ccf190"]
  Counting -> __DECISION__Counting__Tick [label = <<b>Tick</b>>, color = "#ffc700", fontcolor = "#ffdd66"]
  __DECISION__Counting__Tick -> Done [color = "#ffc700", fontcolor = "#ffdd66"]
  __DECISION__Counting__Tick -> Counting [color = "#ffc700", fontcolor = "#ffdd66"]
  Done -> Idle [label = <<b>Reset</b>>, color = "#2f80ed", fontcolor = "#8db9f5"]
}