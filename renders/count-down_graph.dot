digraph {
  graph [
    rankdir = TD
    fontname = Arial
    labelloc = t
    fontsize = 12.0
    bgcolor = "#00000000"
    color = "#c8c8c8"
    fontcolor = "#c8c8c8"
    layout = dot
    rankdir = TD
  ]
  node []
  edge []
  Idle [shape = box, label = <<b>Idle</b>>, fontsize = 12.0, style = filled, fillcolor = "#a3e635", fontcolor = "#4d740e", color = "#a3e635", fontname = Arial, labelloc = c, penwidth = 0.0, height = 0.4]
  Counting [shape = box, label = <<b>Counting</b>>, fontsize = 12.0, style = filled, fillcolor = "#ffc700", fontcolor = "#806300", color = "#ffc700", fontname = Arial, labelloc = c, penwidth = 0.0, height = 0.4]
  decision_Counting_Tick [shape = diamond, label = "?", fontsize = 12.0, fontcolor = "#806300", style = filled, fillcolor = "#ffc700", penwidth = 0.0]
  Done [shape = box, label = <<b>Done</b>>, fontsize = 12.0, style = filled, fillcolor = "#2f80ed", fontcolor = "#082e61", color = "#2f80ed", fontname = Arial, labelloc = c, penwidth = 0.0, height = 0.4]
  Idle -> Counting [color = "#a3e635", fontcolor = "#ccf190", fontsize = 12.0, arrowsize = 0.7, label = <<b>Start</b>>, penwidth = 1.8]
  Counting -> decision_Counting_Tick [color = "#ffc700", fontcolor = "#ffdd66", fontsize = 12.0, arrowsize = 0.7, label = <<b>Tick</b>>, penwidth = 1.8]
  decision_Counting_Tick -> Done [color = "#ffc700", fontcolor = "#ffdd66", fontsize = 12.0, arrowsize = 0.7, penwidth = 1.8]
  decision_Counting_Tick -> Counting [color = "#ffc700", fontcolor = "#ffdd66", fontsize = 12.0, arrowsize = 0.7, penwidth = 1.8]
  Done -> Idle [color = "#2f80ed", fontcolor = "#8db9f5", fontsize = 12.0, arrowsize = 0.7, label = <<b>Reset</b>>, penwidth = 1.8]
}