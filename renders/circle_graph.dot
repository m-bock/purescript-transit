digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#000000"
    color = "#ffffff"
    fontcolor = "#ffffff"
    layout = circo
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  State001 [shape = box, label = <<b>State001</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State002 [shape = box, label = <<b>State002</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State003 [shape = box, label = <<b>State003</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
