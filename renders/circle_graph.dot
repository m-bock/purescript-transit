  State005 [shape = box, label = <<b>State005</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State006 [shape = box, label = <<b>State006</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State007 [shape = box, label = <<b>State007</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State008 [shape = box, label = <<b>State008</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State009 [shape = box, label = <<b>State009</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  State010 [shape = box, label = <<b>State010</b>>, height = 0.4, fontcolor = "#000000", fillcolor = "#c8c8c8", color = "#c8c8c8"]
  
  // Edges
  State001 -> State002 [label = <<b>Msg001</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State002 -> State003 [label = <<b>Msg002</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State003 -> State004 [label = <<b>Msg003</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State004 -> State005 [label = <<b>Msg004</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State005 -> State006 [label = <<b>Msg005</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State006 -> State007 [label = <<b>Msg006</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State007 -> State008 [label = <<b>Msg007</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State008 -> State009 [label = <<b>Msg008</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State009 -> State010 [label = <<b>Msg009</b>>, color = "#828282", fontcolor = "#c8c8c8"]
  State010 -> State001 [label = <<b>Msg010</b>>, color = "#828282", fontcolor = "#c8c8c8"]
}