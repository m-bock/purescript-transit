digraph {
  // Global attributes
  graph [
    layout = "sfdp"
    overlap = false
    K = 2.5
    repulsiveforce = 4
    splines = true
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#000000"
    color = "#ffffff"
    fontcolor = "#ffffff"
    label = <<b>Contrast Dark</b>>
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  SpringGreen [shape = box, label = <<b>SpringGreen</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  LemonYellow [shape = box, label = <<b>LemonYellow</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  OceanBlue [shape = box, label = <<b>OceanBlue</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  CoralPink [shape = box, label = <<b>CoralPink</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  MintTeal [shape = box, label = <<b>MintTeal</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  AquaBlue [shape = box, label = <<b>AquaBlue</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  SunsetOrange [shape = box, label = <<b>SunsetOrange</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  MagentaGlow [shape = box, label = <<b>MagentaGlow</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  OliveGreen [shape = box, label = <<b>OliveGreen</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  VividRed [shape = box, label = <<b>VividRed</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  SkyCyan [shape = box, label = <<b>SkyCyan</b>>, height = 0.4, fontcolor = "#ffffff", fillcolor = "#000000", color = "#ffffff"]
  
  // Edges
  SpringGreen -> LemonYellow [label = <<b>MsgA</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  LemonYellow -> OceanBlue [label = <<b>MsgB</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  OceanBlue -> CoralPink [label = <<b>MsgC</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  CoralPink -> MintTeal [label = <<b>MsgD</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  MintTeal -> AquaBlue [label = <<b>MsgE</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  AquaBlue -> SunsetOrange [label = <<b>MsgF</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  SunsetOrange -> MagentaGlow [label = <<b>MsgG</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  MagentaGlow -> OliveGreen [label = <<b>MsgH</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  OliveGreen -> VividRed [label = <<b>MsgI</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  VividRed -> SkyCyan [label = <<b>MsgJ</b>>, color = "#ffffff", fontcolor = "#ffffff"]
  SkyCyan -> SpringGreen [label = <<b>MsgK</b>>, color = "#ffffff", fontcolor = "#ffffff"]
}