digraph {
  // Global attributes
  graph [
    layout = "sfdp"
    overlap = false
    K = 2.5
    repulsiveforce = 4
    splines = true
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#00000000"
    color = "#c8c8c8"
    fontcolor = "#c8c8c8"
    label = <<b>Harmony Dark</b>>
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  SpringGreen [shape = box, label = <<b>SpringGreen</b>>, height = 0.4, fontcolor = "#4d740e", fillcolor = "#a3e635", color = "#a3e635"]
  LemonYellow [shape = box, label = <<b>LemonYellow</b>>, height = 0.4, fontcolor = "#806300", fillcolor = "#ffc700", color = "#ffc700"]
  OceanBlue [shape = box, label = <<b>OceanBlue</b>>, height = 0.4, fontcolor = "#082e61", fillcolor = "#2f80ed", color = "#2f80ed"]
  CoralPink [shape = box, label = <<b>CoralPink</b>>, height = 0.4, fontcolor = "#850020", fillcolor = "#ff527c", color = "#ff527c"]
  MintTeal [shape = box, label = <<b>MintTeal</b>>, height = 0.4, fontcolor = "#104729", fillcolor = "#2dc472", color = "#2dc472"]
  AquaBlue [shape = box, label = <<b>AquaBlue</b>>, height = 0.4, fontcolor = "#095973", fillcolor = "#56ccf2", color = "#56ccf2"]
  SunsetOrange [shape = box, label = <<b>SunsetOrange</b>>, height = 0.4, fontcolor = "#804109", fillcolor = "#f2994a", color = "#f2994a"]
  MagentaGlow [shape = box, label = <<b>MagentaGlow</b>>, height = 0.4, fontcolor = "#7e0eb9", fillcolor = "#c56cf4", color = "#c56cf4"]
  OliveGreen [shape = box, label = <<b>OliveGreen</b>>, height = 0.4, fontcolor = "#0a2e1d", fillcolor = "#26ab6b", color = "#26ab6b"]
  VividRed [shape = box, label = <<b>VividRed</b>>, height = 0.4, fontcolor = "#971212", fillcolor = "#eb5757", color = "#eb5757"]
  SkyCyan [shape = box, label = <<b>SkyCyan</b>>, height = 0.4, fontcolor = "#103f5d", fillcolor = "#2b97db", color = "#2b97db"]
  
  // Edges
  SpringGreen -> LemonYellow [label = <<b>MsgA</b>>, color = "#a3e635", fontcolor = "#ccf190"]
  LemonYellow -> OceanBlue [label = <<b>MsgB</b>>, color = "#ffc700", fontcolor = "#ffdd66"]
  OceanBlue -> CoralPink [label = <<b>MsgC</b>>, color = "#2f80ed", fontcolor = "#8db9f5"]
  CoralPink -> MintTeal [label = <<b>MsgD</b>>, color = "#ff527c", fontcolor = "#ffb8c9"]
  MintTeal -> AquaBlue [label = <<b>MsgE</b>>, color = "#2dc472", fontcolor = "#76e0a7"]
  AquaBlue -> SunsetOrange [label = <<b>MsgF</b>>, color = "#56ccf2", fontcolor = "#b5e9f9"]
  SunsetOrange -> MagentaGlow [label = <<b>MsgG</b>>, color = "#f2994a", fontcolor = "#f9cfa9"]
  MagentaGlow -> OliveGreen [label = <<b>MsgH</b>>, color = "#c56cf4", fontcolor = "#eacbfb"]
  OliveGreen -> VividRed [label = <<b>MsgI</b>>, color = "#26ab6b", fontcolor = "#5cdb9e"]
  VividRed -> SkyCyan [label = <<b>MsgJ</b>>, color = "#eb5757", fontcolor = "#f6b2b2"]
  SkyCyan -> SpringGreen [label = <<b>MsgK</b>>, color = "#2b97db", fontcolor = "#82c2ea"]
}