digraph {
  // Global attributes
  graph [
    layout = "sfdp"
    overlap = false
    K = 2.5
    repulsiveforce = 4
    splines = true
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#ffffff"
    color = "#000000"
    fontcolor = "#000000"
    label = <<b>Harmony Light</b>>
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  SpringGreen [shape = box, label = <<b>SpringGreen</b>>, height = 0.4, fontcolor = "#6ca114", fillcolor = "#a3e635", color = "#a3e635"]
  LemonYellow [shape = box, label = <<b>LemonYellow</b>>, height = 0.4, fontcolor = "#b38b00", fillcolor = "#ffc700", color = "#ffc700"]
  OceanBlue [shape = box, label = <<b>OceanBlue</b>>, height = 0.4, fontcolor = "#0c4590", fillcolor = "#2f80ed", color = "#2f80ed"]
  CoralPink [shape = box, label = <<b>CoralPink</b>>, height = 0.4, fontcolor = "#b8002c", fillcolor = "#ff527c", color = "#ff527c"]
  MintTeal [shape = box, label = <<b>MintTeal</b>>, height = 0.4, fontcolor = "#1a7142", fillcolor = "#2dc472", color = "#2dc472"]
  AquaBlue [shape = box, label = <<b>AquaBlue</b>>, height = 0.4, fontcolor = "#0d7ea2", fillcolor = "#56ccf2", color = "#56ccf2"]
  SunsetOrange [shape = box, label = <<b>SunsetOrange</b>>, height = 0.4, fontcolor = "#b0590d", fillcolor = "#f2994a", color = "#f2994a"]
  MagentaGlow [shape = box, label = <<b>MagentaGlow</b>>, height = 0.4, fontcolor = "#9e12e8", fillcolor = "#c56cf4", color = "#c56cf4"]
  OliveGreen [shape = box, label = <<b>OliveGreen</b>>, height = 0.4, fontcolor = "#145837", fillcolor = "#26ab6b", color = "#26ab6b"]
  VividRed [shape = box, label = <<b>VividRed</b>>, height = 0.4, fontcolor = "#c41717", fillcolor = "#eb5757", color = "#eb5757"]
  SkyCyan [shape = box, label = <<b>SkyCyan</b>>, height = 0.4, fontcolor = "#175d89", fillcolor = "#2b97db", color = "#2b97db"]
  
  // Edges
  SpringGreen -> LemonYellow [label = <<b>MsgA</b>>, color = "#a3e635", fontcolor = "#6ca114"]
  LemonYellow -> OceanBlue [label = <<b>MsgB</b>>, color = "#ffc700", fontcolor = "#cc9f00"]
  OceanBlue -> CoralPink [label = <<b>MsgC</b>>, color = "#2f80ed", fontcolor = "#115bbf"]
  CoralPink -> MintTeal [label = <<b>MsgD</b>>, color = "#ff527c", fontcolor = "#ff0642"]
  MintTeal -> AquaBlue [label = <<b>MsgE</b>>, color = "#2dc472", fontcolor = "#1a7142"]
  AquaBlue -> SunsetOrange [label = <<b>MsgF</b>>, color = "#56ccf2", fontcolor = "#10a3d2"]
  SunsetOrange -> MagentaGlow [label = <<b>MsgG</b>>, color = "#f2994a", fontcolor = "#e07210"]
  MagentaGlow -> OliveGreen [label = <<b>MsgH</b>>, color = "#c56cf4", fontcolor = "#9e12e8"]
  OliveGreen -> VividRed [label = <<b>MsgI</b>>, color = "#26ab6b", fontcolor = "#145837"]
  VividRed -> SkyCyan [label = <<b>MsgJ</b>>, color = "#eb5757", fontcolor = "#c41717"]
  SkyCyan -> SpringGreen [label = <<b>MsgK</b>>, color = "#2b97db", fontcolor = "#175d89"]
}