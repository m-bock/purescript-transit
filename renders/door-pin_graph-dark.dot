digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#00000000"
    color = "#c8c8c8"
    fontcolor = "#c8c8c8"
    layout = dot
    rankdir = LR
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Entry points
  __ENTRY__DoorOpen [shape = circle, label = "", width = 0.15, height = 0.15, fixedsize = true, fillcolor = "#8c8c8c"]
  
  // Nodes
  DoorOpen [shape = box, label = <<b>DoorOpen</b>>, height = 0.4, fontcolor = "#4d740e", fillcolor = "#a3e635", color = "#a3e635"]
  DoorClosed [shape = box, label = <<b>DoorClosed</b>>, height = 0.4, fontcolor = "#806300", fillcolor = "#ffc700", color = "#ffc700"]
  DoorLocked [shape = box, label = <<b>DoorLocked</b>>, height = 0.4, fontcolor = "#082e61", fillcolor = "#2f80ed", color = "#2f80ed"]
  __DECISION__DoorLocked__Unlock [shape = diamond, label = "?", fontcolor = "#082e61", fillcolor = "#2f80ed"]
  
  // Edges
  __ENTRY__DoorOpen -> DoorOpen [color = "#8c8c8c"]
  DoorOpen -> DoorClosed [label = <<b>Close</b>>, color = "#a3e635", fontcolor = "#ccf190"]
  DoorClosed -> DoorOpen [label = <<b>Open</b>>, color = "#ffc700", fontcolor = "#ffdd66"]
  DoorClosed -> DoorLocked [label = <<b>Lock</b>>, color = "#ffc700", fontcolor = "#ffdd66"]
  DoorLocked -> __DECISION__DoorLocked__Unlock [label = <<b>Unlock</b>>, color = "#2f80ed", fontcolor = "#8db9f5"]
  __DECISION__DoorLocked__Unlock -> DoorLocked [label = <<i>PinIncorrect</i>>, color = "#2f80ed", fontcolor = "#8db9f5"]
  __DECISION__DoorLocked__Unlock -> DoorClosed [label = <<i>PinCorrect</i>>, color = "#2f80ed", fontcolor = "#8db9f5"]
}