digraph {
  // Global attributes
  graph [
    rankdir = TD
    labelloc = t
    fontsize = 12.0
    bgcolor = "#ffffff"
    color = "#000000"
    fontcolor = "#000000"
    layout = dot
    rankdir = TD
  ]
  node [
    style = filled
    fontsize = 12.0
    fontname = Arial
    penwidth = 0.0
    labelloc = c
  ]
  edge [
    arrowsize = 0.7
    penwidth = 1.8
    fontsize = 12.0
  ]
  
  // Nodes
  DoorOpen [shape = box, label = <<b>DoorOpen</b>>, height = 0.4, fontcolor = "#6ca114", fillcolor = "#a3e635", color = "#a3e635"]
  DoorClosed [shape = box, label = <<b>DoorClosed</b>>, height = 0.4, fontcolor = "#b38b00", fillcolor = "#ffc700", color = "#ffc700"]
  
  // Edges
  DoorOpen -> DoorClosed [label = <<b>Close</b>>, color = "#a3e635", fontcolor = "#6ca114"]
  DoorClosed -> DoorOpen [label = <<b>Open</b>>, color = "#ffc700", fontcolor = "#cc9f00"]
}